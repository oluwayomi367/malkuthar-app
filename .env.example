APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# Paiements — FedaPay (§22, §26). Clés « test » du dashboard :
#   https://sandbox-checkout.fedapay.com  → Paramètres → API
# FEDAPAY_ENVIRONMENT = sandbox (test) | live (production)
# Le webhook secret vient de : Dashboard → Webhooks → (créer un
# endpoint pointant sur  https://VOTRE_DOMAINE/webhooks/fedapay )
# ─────────────────────────────────────────────────────────────
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_ENVIRONMENT=sandbox

# Paiements — CinetPay (alternative)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_ENVIRONMENT=sandbox

# ─────────────────────────────────────────────────────────────
# Marketplace multi-vendeurs — voir config/marketplace.php et
# docs/MARKETPLACE.md. Tant que MARKETPLACE_ENABLED=false, les
# routes publiques et l'espace vendeur restent masqués (404).
# ─────────────────────────────────────────────────────────────
MARKETPLACE_ENABLED=false
MARKETPLACE_DEFAULT_COMMISSION=0.15
MARKETPLACE_GROWTH_RATE=0.10
MARKETPLACE_GROWTH_THRESHOLD=3000000
MARKETPLACE_SETTLEMENT_HOLD_DAYS=14
MARKETPLACE_MIN_PAYOUT=5000
MARKETPLACE_PAYOUT_SCHEDULE=on_demand
MARKETPLACE_PAYOUT_COOLDOWN_HOURS=24
MARKETPLACE_VENDOR_SELF_PUBLISH=false
MARKETPLACE_AUTO_APPROVE_TRUSTED=false
MARKETPLACE_MAX_GALLERY=8
